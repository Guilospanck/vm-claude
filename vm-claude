#!/usr/bin/env bash
#
# vm-claude — run Claude Code inside a microsandbox microVM, anywhere.
#
# Isolates Claude Code from the host: only the current project dir is mounted
# (rw) into the guest at /workspace. Auth/config/session state persist in the
# VM's root disk, keyed per project, so resuming is instant.
#
# Docs: https://docs.microsandbox.dev/examples/agents/claude-code
#
# Usage:
#   vm-claude                 # run claude in a VM for $PWD
#   vm-claude --shell         # drop into a shell in the VM instead
#   vm-claude --show-config   # list the ~/.claude files a run would copy in
#   vm-claude --stop          # stop this project's VM
#   vm-claude --rm            # stop + delete VM (wipes its auth/session state)
#   vm-claude --sign-on-exit  # sign the VM's commits on the host when it exits
#   vm-claude --no-clip       # disable the clipboard bridge (on by default)
#   vm-claude --worktree NAME # run in a git worktree (created if missing) in the
#                             # same VM; gitignored files are copied in on create
#   vm-claude --cpus 4 --memory 8G --disk 16G
#                             # sizes for this run; on a new VM they're applied
#                             # at boot, on an existing one only with --resize
#   vm-claude --resize        # push those sizes onto the EXISTING VM: cpu/ram
#                             # change live; a disk size or a new --max-* ceiling
#                             # reboots it (keeping its disk/auth/session state);
#                             # a --disk the VM already has is skipped, not fatal
#   vm-claude -- <args...>    # pass args straight to `claude`
#
# claude runs with --dangerously-skip-permissions by default: the microVM is
# already the sandbox, so a second permission prompt inside it buys little.
# Set CLAUDE_VM_SKIP_PERMISSIONS=0 to get the normal prompts back.
#
# Env overrides:
#   CLAUDE_VM_VERSION   npm version of @anthropic-ai/claude-code, installed on
#                       every start/resume (default "latest"; pin to e.g. 2.1.235)
#   CLAUDE_VM_IMAGE     base OCI image           (default node:24-bookworm-slim)
#   CLAUDE_VM_CPUS      vCPUs                     (default 2)
#   CLAUDE_VM_MEMORY    RAM                       (default 4G)
#   CLAUDE_VM_DISK      root disk                 (default 4G)
#   CLAUDE_VM_MAX_CPUS      live-resize ceiling for vCPUs  (default: CPUS)
#   CLAUDE_VM_MAX_MEMORY    live-resize ceiling for RAM    (default: MEMORY)
#                       These are fixed when the VM boots and default to the
#                       starting size, i.e. no room to grow. Set them above
#                       CPUS/MEMORY to leave headroom that a later `--resize`
#                       can claim live. Raising them on an existing VM works
#                       too (`--resize`), at the cost of one reboot.
#   CLAUDE_VM_MOUNT     host dir to mount as /workspace (default: $PWD)
#   CLAUDE_VM_SKIP_PERMISSIONS  1 (default) passes --dangerously-skip-permissions
#   CLAUDE_VM_SIGN_ON_EXIT      1/0 forces --sign-on-exit on/off (default: on
#                               when the host has commit.gpgsign=true)
#   CLAUDE_VM_TZ        timezone for the guest    (default: the host's)
#   CLAUDE_VM_CONFIG    1 (default) ships a safe subset of ~/.claude into the
#                       guest; 0 leaves the guest with a virgin config
#   CLAUDE_VM_CONFIG_DIR    host config dir to copy from (default ~/.claude)
#   CLAUDE_VM_CONFIG_ITEMS  space-separated allowlist of entries to copy
#   CLAUDE_VM_CONFIG_MAX_KB size ceiling for that copy, uncompressed (default 2048)
#   CLAUDE_VM_SETTINGS_STRIP  extra settings.json keys to drop (env, hooks,
#                       statusLine and credential helpers are always dropped)
#   CLAUDE_VM_CLIP      1 (default) bridges the macOS clipboard into the guest so
#                       Claude's Ctrl-V image paste works, approving each paste
#                       via a host dialog; 0 (or --no-clip) turns it off. macOS
#                       host only; pngpaste is auto-installed via Homebrew.
#   CLAUDE_VM_WORKTREE_DIR  subdir under the repo root that holds --worktree
#                       checkouts (default ".vm-worktrees")

set -euo pipefail

VERSION="${CLAUDE_VM_VERSION:-latest}"
# Default to the AWS ECR public mirror of Docker's official images: anonymous
# pull, no Docker Hub rate limit / 401. Override with a Hub tag if you prefer.
IMAGE="${CLAUDE_VM_IMAGE:-public.ecr.aws/docker/library/node:24-bookworm-slim}"
CPUS="${CLAUDE_VM_CPUS:-2}"
MEMORY="${CLAUDE_VM_MEMORY:-4G}"
DISK="${CLAUDE_VM_DISK:-4G}"
# Resize ceilings. msb grows a RUNNING VM's cpu/ram (msb modify) only up to the
# max_cpus/max_memory it booted with, and those default to the starting size --
# so headroom has to be asked for up front. Left empty here and defaulted to
# CPUS/MEMORY in resolve_limits(), after the CLI parse has had its say.
MAX_CPUS="${CLAUDE_VM_MAX_CPUS:-}"
MAX_MEMORY="${CLAUDE_VM_MAX_MEMORY:-}"
MAX_FLAGS=()
CEILING_SET=0
# Only pass --root-disk to a resize when a size was actually asked for: the disk
# arm of `msb modify` reboots the VM, and nobody wants that on every --resize.
DISK_EXPLICIT=0
if [ -n "${CLAUDE_VM_DISK:-}" ]; then DISK_EXPLICIT=1; fi
RESIZE=0
MOUNT_DIR="${CLAUDE_VM_MOUNT:-$PWD}"
SKIP_PERMISSIONS="${CLAUDE_VM_SKIP_PERMISSIONS:-1}"
HEAD_BEFORE=""

# --worktree: run in a git worktree of the mounted repo instead of at its root.
# The worktree lives UNDER the repo root (so it's inside the existing /workspace
# mount and reuses the same VM), and sign-on-exit operates on it rather than the
# root. HOST_GIT_WORKTREE is the host repo path the signing hook targets; it
# defaults to MOUNT_DIR and is repointed at the worktree when --worktree is used.
WORKTREE_NAME=""
WORKTREE_SUBDIR="${CLAUDE_VM_WORKTREE_DIR:-.vm-worktrees}"
HOST_GIT_WORKTREE=""

# Default sign-on-exit ON when the host is already set up to sign commits
# (commit.gpgsign=true) -- otherwise a VM session silently leaves a run of
# unsigned commits behind, which is exactly what that host wanted to avoid. An
# explicit CLAUDE_VM_SIGN_ON_EXIT wins; so do --sign-on-exit / --no-sign-on-exit.
if [ -n "${CLAUDE_VM_SIGN_ON_EXIT:-}" ]; then
  SIGN_ON_EXIT="$CLAUDE_VM_SIGN_ON_EXIT"
elif command -v git >/dev/null 2>&1 \
  && [ "$(git config --global --type=bool --get commit.gpgsign 2>/dev/null)" = "true" ]; then
  SIGN_ON_EXIT=1
else
  SIGN_ON_EXIT=0
fi

# Which of the host's ~/.claude to carry into the guest. An allowlist, for the
# same reason host_git_config is one: everything not named here — credentials,
# history, transcripts, other projects' state — stays on the host.
CONFIG_SYNC="${CLAUDE_VM_CONFIG:-1}"
CONFIG_SRC="${CLAUDE_VM_CONFIG_DIR:-$HOME/.claude}"
# hooks/ isn't on the list: settings.json's `hooks` key never crosses (see
# CONFIG_STRIP_ALWAYS), so the scripts would be dead weight -- often megabytes.
CONFIG_ITEMS="${CLAUDE_VM_CONFIG_ITEMS:-CLAUDE.md settings.json keybindings.json agents commands skills output-styles}"
# Ceiling on the uncompressed size of what gets copied: a guard against
# shipping far more of the host than intended, not a transport limit.
CONFIG_MAX_KB="${CLAUDE_VM_CONFIG_MAX_KB:-2048}"

# EXTRA top-level keys to delete from the shipped settings.json, on the host,
# before it's copied. The always-stripped set (env, hooks, statusLine, and the
# credential-helper commands) is in CONFIG_STRIP_ALWAYS and can't be turned off.
CONFIG_STRIP="${CLAUDE_VM_SETTINGS_STRIP:-}"

# --- clipboard bridge (opt-in) ---------------------------------------------
# Claude Code reads a pasted image by shelling out to `xclip`/`wl-paste` in the
# guest, which has no clipboard -- so image paste (Ctrl-V) is dead by default.
# With --clip (or CLAUDE_VM_CLIP=1) we bridge it: a host watcher serves the
# macOS pasteboard through a shared dir, and a shim named `xclip` in the guest
# fetches it. Every fetch pops a host approval dialog, so a rogue guest can make
# the prompt appear but can't read anything without a human click. The request
# from the guest is what identifies which VM is asking, so this works no matter
# how windows/panes are split -- something a host-side hotkey can't do.
#
# On by default; --no-clip (or CLAUDE_VM_CLIP=0) turns it off. macOS host only,
# and images need `pngpaste`, which is auto-installed via Homebrew when missing
# (like msb) -- if that can't happen, image paste degrades off and text still
# works. The shared dir is an extra mount and mounts are fixed at boot, so
# enabling it on a VM that was first booted without it needs `--rm` and a fresh
# start; a resume that finds the bridge missing says so and carries on.
CLIP_ENABLE="${CLAUDE_VM_CLIP:-1}"
CLIP_EXPLICIT=0
[ -n "${CLAUDE_VM_CLIP:-}" ] && CLIP_EXPLICIT=1
WATCHER_PID=""

# Guest shim: impersonates just enough of xclip(1) for Claude's paste probe.
# The presence probe (TARGETS) is answered silently; each *content* fetch
# round-trips to the host watcher, which asks the user. Written verbatim into
# the guest at /usr/local/bin/xclip (nothing real is there to shadow).
#
# Read via `read -r -d ''` rather than "$(cat <<'EOS')": a heredoc inside command
# substitution is mishandled by the bash 3.2 that ships with macOS. `read` hits
# EOF and returns non-zero, hence the `|| true` under `set -e`.
IFS= read -r -d '' CLIP_SHIM_SRC <<'EOS' || true
#!/bin/sh
# vm-claude clipboard shim (guest side). Serves the host pasteboard, gated by a
# per-paste approval dialog the host watcher shows. See vm-claude for the design.
CLIP="${VM_CLIP_DIR:-/run/vm-clip}"

# No bridge mounted / no watcher running -> behave like an empty clipboard,
# instantly, rather than hang on a round-trip that will never be answered.
[ -e "$CLIP/ready" ] || exit 1

target=""
while [ $# -gt 0 ]; do
  case "$1" in
    -t) target="${2:-}"; shift 2 ;;
    -selection) shift 2 ;;
    *) shift ;;
  esac
done

# Drop a content-free trigger and wait for the host to answer. The trigger's
# existence is the whole message; the watcher never reads its contents.
roundtrip() {                       # $1 = probe|image|text
  rm -f "$CLIP/$1.done" 2>/dev/null
  : > "$CLIP/$1.req"
  n=0
  while [ "$n" -lt 300 ]; do        # ~30s ceiling (dialog itself times out first)
    [ -e "$CLIP/$1.done" ] && { rm -f "$CLIP/$1.done"; return 0; }
    n=$((n + 1)); sleep 0.1
  done
  return 1
}

case "$target" in
  TARGETS)                          # silent presence probe, no dialog
    roundtrip probe || exit 1
    [ -e "$CLIP/has.png" ] && printf 'image/png\n'
    [ -e "$CLIP/has.txt" ] && printf 'text/plain\n'
    ;;
  image/png)
    roundtrip image || exit 1
    [ -s "$CLIP/out.png" ] && exec cat "$CLIP/out.png"
    exit 1 ;;
  text/plain)
    roundtrip text || exit 1
    [ -s "$CLIP/out.txt" ] && exec cat "$CLIP/out.txt"
    exit 1 ;;
  *)
    exit 1 ;;
esac
EOS

# Host watcher (macOS). Bridges the pasteboard to the guest shim, prompting the
# user before every content fetch. Security-critical invariants, all in one spot:
#   - the guest can only create *.req TRIGGERS; their contents are never read.
#   - everything handed back is staged in a host-only dir ($WORK) and renamed
#     onto the same filesystem into the shared mount ($SHARED); a symlink the
#     guest plants in $SHARED can't redirect our writes (rename replaces it).
#   - the dialog string is composed here -- no guest bytes ever reach osascript.
# Read via `read -r -d ''` for the same bash-3.2 reason as the shim above.
IFS= read -r -d '' CLIP_WATCHER_SRC <<'EOW' || true
#!/bin/sh
set -eu
SHARED="$1"; WORK="$2"; NAME="$3"
mkdir -p "$SHARED" "$WORK"

have_png=0
if command -v pngpaste >/dev/null 2>&1; then
  have_png=1
else
  echo "vm-claude clipboard: pngpaste not found (brew install pngpaste); image paste off, text still works." >&2
fi

# symlink-safe writes: stage in $WORK, rename onto the same fs into $SHARED.
mark()   { : > "$WORK/.m" && mv -f "$WORK/.m" "$SHARED/$1"; }
unmark() { rm -f "$SHARED/$1"; }

ask() {  # $1 = image|text ; returns 0 on Allow. Text is host-composed only.
  osascript -e "display dialog \"${NAME} wants to read your clipboard (${1}). Allow this paste?\" buttons {\"Deny\", \"Allow\"} default button \"Deny\" cancel button \"Deny\" with title \"vm-claude clipboard\" with icon caution giving up after 20" 2>/dev/null | grep -q "button returned:Allow"
}

cleanup() { rm -f "$SHARED/ready" 2>/dev/null || true; }
trap 'cleanup; exit 0' TERM INT
trap cleanup EXIT

mark ready
while [ -d "$SHARED" ]; do
  # Self-terminate if the vm-claude that launched us is gone -- an orphan
  # reparents to PID 1. Covers hard kills where our EXIT trap never fired, so a
  # watcher can't outlive its session even when nothing gets to reap it.
  [ "$(ps -o ppid= -p "$$" 2>/dev/null | tr -d ' ')" = 1 ] && { cleanup; exit 0; }
  if [ -e "$SHARED/probe.req" ]; then
    rm -f "$SHARED/probe.req"; unmark has.png; unmark has.txt
    if [ "$have_png" = 1 ] && pngpaste "$WORK/c.png" >/dev/null 2>&1 && [ -s "$WORK/c.png" ]; then mark has.png; fi
    if pbpaste 2>/dev/null | grep -q .; then mark has.txt; fi
    mark probe.done
  fi
  if [ -e "$SHARED/image.req" ]; then
    rm -f "$SHARED/image.req"; unmark out.png
    if [ "$have_png" = 1 ] && ask image && pngpaste "$WORK/c.png" >/dev/null 2>&1 && [ -s "$WORK/c.png" ]; then
      rm -f "$SHARED/out.png"; mv -f "$WORK/c.png" "$SHARED/out.png"
    fi
    mark image.done
  fi
  if [ -e "$SHARED/text.req" ]; then
    rm -f "$SHARED/text.req"; unmark out.txt
    if ask text && pbpaste > "$WORK/c.txt" 2>/dev/null; then
      rm -f "$SHARED/out.txt"; mv -f "$WORK/c.txt" "$SHARED/out.txt"
    fi
    mark text.done
  fi
  sleep 0.15
done
EOW

# --- resolve mount to an absolute path -------------------------------------
MOUNT_DIR="$(cd "$MOUNT_DIR" && pwd)"

# If inside a git repo, mount the repo ROOT (so .git is visible in the guest)
# and remember the sub-path so we land in the same dir inside /workspace.
SUBPATH=""
if [ -z "${CLAUDE_VM_MOUNT:-}" ] && command -v git >/dev/null 2>&1; then
  # Hooks/fsmonitor off, as for every host git call on the repo (see hgit below).
  if root="$(cd "$MOUNT_DIR" && git -c core.hooksPath=/dev/null -c core.fsmonitor=false rev-parse --show-toplevel 2>/dev/null)"; then
    SUBPATH="${MOUNT_DIR#"$root"}"   # e.g. "" or "/sub/dir"
    MOUNT_DIR="$root"
  fi
fi
GUEST_WORKDIR="/workspace${SUBPATH}"

# sign-on-exit targets the mounted repo by default; --worktree repoints it below.
HOST_GIT_WORKTREE="$MOUNT_DIR"
WT_HOST=""

# Pre-scan args for --worktree so the resolution below (and the VM name) can
# account for it -- this runs before main() does the authoritative parse. Stop
# at `--` so a --worktree meant for `claude` isn't mistaken for ours.
_prev=""
for _a in "$@"; do
  [ "$_a" = "--" ] && break
  case "$_prev" in --worktree) WORKTREE_NAME="$_a" ;; esac
  case "$_a" in --worktree=*) WORKTREE_NAME="${_a#*=}" ;; esac
  _prev="$_a"
done
unset _prev _a

# --- resolve --worktree ----------------------------------------------------
# The worktree lives at <repo-root>/<subdir>/<name>, which is under the mounted
# /workspace, so the same VM sees it with no remount. MOUNT_DIR (and thus the VM
# name) stays the repo root -> same VM for every worktree of a repo.
if [ -n "$WORKTREE_NAME" ]; then
  command -v git >/dev/null 2>&1 || {
    echo "vm-claude: --worktree needs git on the host." >&2; exit 1
  }
  if ! WT_ROOT="$(cd "$MOUNT_DIR" && git -c core.hooksPath=/dev/null -c core.fsmonitor=false rev-parse --show-toplevel 2>/dev/null)"; then
    echo "vm-claude: --worktree needs to be run inside a git repo (${MOUNT_DIR} isn't one)." >&2
    exit 1
  fi
  MOUNT_DIR="$WT_ROOT"
  case "$WORKTREE_NAME" in
    */*|.|..) echo "vm-claude: --worktree name must be a single path segment." >&2; exit 1 ;;
  esac
  WT_HOST="${MOUNT_DIR}/${WORKTREE_SUBDIR}/${WORKTREE_NAME}"
  GUEST_WORKDIR="/workspace/${WORKTREE_SUBDIR}/${WORKTREE_NAME}"
  HOST_GIT_WORKTREE="$WT_HOST"
fi

# --- stable per-project VM name --------------------------------------------
# Hash the absolute path so each project gets its own persistent VM.
hash="$(printf '%s' "$MOUNT_DIR" | cksum | cut -d' ' -f1)"
NAME="vm-claude-$(basename "$MOUNT_DIR")-${hash}"

# Per-VM host dirs for the clipboard bridge: `shared` is mounted into the guest,
# `work` is host-only staging on the SAME filesystem, so renames of served files
# into `shared` are atomic and can't be redirected by a guest-planted symlink.
CLIP_ROOT="${XDG_CACHE_HOME:-$HOME/.cache}/vm-claude/clip/${NAME}"
CLIP_SHARED="${CLIP_ROOT}/shared"
CLIP_WORK="${CLIP_ROOT}/work"

# --- host timezone ---------------------------------------------------------
# The guest is UTC otherwise, which shows up as a +0000 offset on every commit
# made inside the VM while host commits carry the real local offset.
host_timezone() {
  local tz="${CLAUDE_VM_TZ:-${TZ:-}}"

  if [ -z "$tz" ] && [ -r /etc/timezone ]; then
    tz="$(cat /etc/timezone 2>/dev/null)"
  fi
  # macOS and most Linux: /etc/localtime -> .../zoneinfo/Europe/Lisbon
  if [ -z "$tz" ] && [ -L /etc/localtime ]; then
    local target
    target="$(readlink /etc/localtime)"
    tz="${target##*zoneinfo/}"
  fi

  # Only accept a plausible Area/City name. This gets inlined into a command
  # run in the guest, so anything unexpected is dropped rather than escaped.
  case "$tz" in
    ''|/*|*[!A-Za-z0-9_/+-]*) tz="" ;;
  esac
  printf '%s' "$tz"
}

TZ_NAME="$(host_timezone)"

# Shell fragment (ending in `&&`) that pins the guest clock, or nothing.
tz_setup_cmd() {
  [ -n "$TZ_NAME" ] || return 0
  printf 'ln -sf /usr/share/zoneinfo/%s /etc/localtime && printf %s > /etc/timezone && export TZ=%s &&\n' \
    "$TZ_NAME" "$TZ_NAME" "$TZ_NAME"
}

# --- ensure msb CLI is present ---------------------------------------------
ensure_msb() {
  if command -v msb >/dev/null 2>&1; then
    return
  fi
  echo "msb (microsandbox) not found -> installing..." >&2
  case "$(uname -s)" in
    Linux|Darwin)
      curl -fsSL https://install.microsandbox.dev | sh
      ;;
    *)
      echo "Unsupported OS. Install msb manually: https://docs.microsandbox.dev" >&2
      exit 1
      ;;
  esac
  # install script drops msb in ~/.local/bin typically
  if ! command -v msb >/dev/null 2>&1; then
    export PATH="$HOME/.local/bin:$PATH"
  fi
  command -v msb >/dev/null 2>&1 || {
    echo "msb still not on PATH. Add its install dir to PATH and re-run." >&2
    exit 1
  }
}

# --- ensure pngpaste is present (for image paste) ---------------------------
# Like ensure_msb, but non-fatal: pngpaste only powers image paste, so if it
# can't be installed we warn and let the session run (text paste still works).
# macOS + Homebrew only -- pngpaste has no portable installer.
ensure_pngpaste() {
  command -v pngpaste >/dev/null 2>&1 && return 0
  if command -v brew >/dev/null 2>&1; then
    echo "clipboard: pngpaste not found -> installing via Homebrew..." >&2
    brew install pngpaste >/dev/null 2>&1 \
      || echo "clipboard: 'brew install pngpaste' failed; image paste disabled (text paste still works)." >&2
  else
    echo "clipboard: pngpaste not found and Homebrew is not installed; image paste disabled (text paste still works)." >&2
    echo "  install Homebrew (https://brew.sh) then 'brew install pngpaste' to enable image paste." >&2
  fi
}

# --- does the VM already exist? --------------------------------------------
vm_exists() {
  msb list 2>/dev/null | grep -q "\b${NAME}\b"
}

# --- resource ceilings ------------------------------------------------------
# Runs after the CLI parse so --cpus/--memory feed the defaults. The --max-*
# flags are emitted ONLY when headroom was actually requested, so an msb too old
# to know them keeps working for everyone who never asked.
resolve_limits() {
  : "${MAX_CPUS:=$CPUS}"
  : "${MAX_MEMORY:=$MEMORY}"
  MAX_FLAGS=()
  if [ "$MAX_CPUS" != "$CPUS" ]; then
    MAX_FLAGS+=(--max-cpus "$MAX_CPUS"); CEILING_SET=1
  fi
  if [ "$MAX_MEMORY" != "$MEMORY" ]; then
    MAX_FLAGS+=(--max-memory "$MAX_MEMORY"); CEILING_SET=1
  fi
}

# --- push new sizes onto an existing VM (--resize) --------------------------
# Three boundaries, which is why this builds the flag list rather than always
# sending everything:
#   * cpu/ram apply LIVE, but only up to the ceiling the VM booted with.
#   * the ceilings themselves, and the root disk, are fixed at boot -- changing
#     either needs a reboot, so those arms add --restart.
#   * the root disk only ever grows.
# A reboot here is not a --rm: the disk contents, auth and session history
# included, survive it. So a VM created before ceilings existed can still be
# given headroom -- `--resize --max-cpus N --max-memory X` costs one restart.
# Best-effort by design -- a refused resize (no headroom, a shrink, an msb
# without `modify`) is reported and the session continues at the current size.
#
# `msb modify` is all-or-nothing: one refused arm and NOTHING is applied. The
# disk arm is the one that trips on a harmless re-run -- the same `--disk 32G`
# that grew the disk yesterday is a "shrink" today -- so that refusal is
# retried without the disk, and cpu/ram still land.
resize_flags() {
  local with_disk="$1"
  RESIZE_FLAGS=(--cpus "$CPUS" --memory "$MEMORY")
  RESIZE_WHAT="${CPUS} cpu / ${MEMORY} ram"
  local reboot=0
  if [ "$with_disk" = "1" ]; then
    RESIZE_FLAGS+=(--root-disk "$DISK")
    RESIZE_WHAT="${RESIZE_WHAT} / ${DISK} disk"
    reboot=1
  fi
  if [ "$CEILING_SET" = "1" ]; then
    RESIZE_FLAGS+=("${MAX_FLAGS[@]}")
    RESIZE_WHAT="${RESIZE_WHAT}, ceiling ${MAX_CPUS} cpu / ${MAX_MEMORY}"
    reboot=1
  fi
  if [ "$reboot" = "1" ]; then
    RESIZE_FLAGS+=(--restart)
    RESIZE_WHAT="${RESIZE_WHAT} (reboots the VM)"
  fi
}

apply_resize() {
  local errf err
  errf="$(mktemp)"
  resize_flags "$DISK_EXPLICIT"
  echo "Resizing '${NAME}' -> ${RESIZE_WHAT}..." >&2
  if msb modify "$NAME" "${RESIZE_FLAGS[@]}" 2>"$errf"; then
    cat "$errf" >&2; rm -f "$errf"; return 0
  fi
  err="$(cat "$errf")"
  # Disk already at (or above) the requested size: drop that arm and retry so
  # the cpu/ram change is not lost with it.
  if [ "$DISK_EXPLICIT" = "1" ] && printf '%s' "$err" | grep -q "root disk size is already"; then
    echo "vm-claude: root disk is already >= ${DISK} and only grows; leaving it as is." >&2
    resize_flags 0
    echo "Resizing '${NAME}' -> ${RESIZE_WHAT}..." >&2
    if msb modify "$NAME" "${RESIZE_FLAGS[@]}" 2>"$errf"; then
      cat "$errf" >&2; rm -f "$errf"; return 0
    fi
    err="$(cat "$errf")"
  fi
  rm -f "$errf"
  printf '%s\n' "$err" >&2
  echo "vm-claude: resize refused; continuing at the VM's current size." >&2
  echo "  cpu/ram grow only up to the ceiling the VM booted with ('msb ps'" >&2
  echo "  shows effective / max); the root disk only grows. To raise the" >&2
  echo "  ceiling, re-run with --resize --max-cpus N --max-memory X, which" >&2
  echo "  reboots the VM but keeps its disk, auth and session history." >&2
}

# Emit `git config --global` commands for the SAFE subset of the host config.
# Explicitly excludes anything that could carry secrets: credential.*, *.token,
# user.signingkey, gpg.*, http.*, url.*.insteadOf, sendemail.*, etc.
host_git_config() {
  command -v git >/dev/null 2>&1 || return 0

  # exact keys to copy verbatim if present on the host
  local keys="user.name user.email init.defaultBranch pull.rebase \
    push.default push.autoSetupRemote rebase.autostash fetch.prune \
    merge.conflictstyle diff.colorMoved color.ui"

  local k v esc
  for k in $keys; do
    v="$(git config --global --get "$k" 2>/dev/null)" || continue
    [ -n "$v" ] || continue
    esc="$(printf "%s" "$v" | sed "s/'/'\\\\''/g")"
    printf "git config --global '%s' '%s' && " "$k" "$esc"
  done

  # all aliases (alias.<name> = <value>); values may contain spaces
  git config --global --get-regexp '^alias\.' 2>/dev/null | while IFS= read -r line; do
    k="${line%% *}"; v="${line#* }"
    esc="$(printf "%s" "$v" | sed "s/'/'\\\\''/g")"
    printf "git config --global '%s' '%s' && " "$k" "$esc"
  done
}

# --- host ~/.claude config -------------------------------------------------
# The guest keeps its own ~/.claude (that's where its auth and sessions live),
# so out of the box it has none of the user's actual configuration: no global
# CLAUDE.md, no settings, no custom agents/commands/skills.
#
# Ship an allowlisted, sanitized copy of those as one tarball. It's staged in a
# private host dir, copied into the guest (--copy-file on a fresh boot, streamed
# over `msb exec --stream` on resume), checked against its manifest there and
# only then swapped in. Deliberately NOT a mount of ~/.claude: that would put
# .credentials.json and every other project's transcripts inside the box for
# the life of the VM, which is exactly what this tool exists to avoid. Only what
# is staged here ever leaves the host.
CONFIG_TMP=""
CONFIG_BUNDLE=""
GUEST_BUNDLE=""
GUEST_STATE_DIR=/var/lib/vm-claude

# settings.json keys that never cross, whatever CLAUDE_VM_SETTINGS_STRIP says:
# env is where people keep tokens, and the rest name host-side commands (hooks,
# status line, credential helpers) that don't exist in the guest.
CONFIG_STRIP_ALWAYS="env hooks statusLine apiKeyHelper awsAuthRefresh awsCredentialExport otelHeadersHelper"

# Basenames that are never shipped, wherever they turn up in the copied tree.
config_denied() {
  case "$1" in
    .credentials.json|credentials.json|auth.json|.netrc|.npmrc|.pypirc|history.jsonl) return 0 ;;
    id_rsa|id_rsa.*|id_dsa|id_dsa.*|id_ecdsa|id_ecdsa.*|id_ed25519|id_ed25519.*) return 0 ;;
    *.pem|*.key|*.p12|*.pfx|.env|.env.*) return 0 ;;
  esac
  return 1
}

# Write settings.json ($1) to $2 minus the stripped keys. Fails closed: unless
# the input parses as a JSON object and a JSON tool is on the host, nothing is
# written -- an unsanitized settings.json never reaches the guest.
sanitize_settings() {
  local src="$1" dst="$2" keys="$CONFIG_STRIP_ALWAYS $CONFIG_STRIP"
  rm -f "$dst" "$dst.tmp"
  if command -v jq >/dev/null 2>&1; then
    jq --arg keys "$keys" \
      'if type == "object" then reduce ($keys | split(" ")[] | select(length > 0)) as $k (.; del(.[$k])) else error("not an object") end' \
      "$src" > "$dst.tmp" 2>/dev/null
  elif command -v node >/dev/null 2>&1; then
    node -e 'const fs = require("fs"); const [src, dst, keys] = process.argv.slice(1);
      const s = JSON.parse(fs.readFileSync(src, "utf8"));
      if (s === null || typeof s !== "object" || Array.isArray(s)) process.exit(1);
      for (const k of keys.split(/\s+/).filter(Boolean)) delete s[k];
      fs.writeFileSync(dst, JSON.stringify(s, null, 2) + "\n");' "$src" "$dst.tmp" "$keys" 2>/dev/null
  elif command -v python3 >/dev/null 2>&1; then
    python3 -c 'import json, sys
s = json.load(open(sys.argv[1]))
if not isinstance(s, dict): sys.exit(1)
for k in sys.argv[3].split(): s.pop(k, None)
json.dump(s, open(sys.argv[2], "w"), indent=2)' "$src" "$dst.tmp" "$keys" 2>/dev/null
  else
    return 1
  fi && [ -s "$dst.tmp" ] && mv -f "$dst.tmp" "$dst" || { rm -f "$dst.tmp"; return 1; }
}

# Physical path of the directory the symlink $1 points at (resolved from where
# the link itself lives), or failure when it's dangling or not a directory.
link_dir_target() {
  local t
  t="$(readlink "$1")" || return 1
  (cd -P "$(dirname "$1")" 2>/dev/null && cd -P "$t" 2>/dev/null && pwd -P)
}

# Symlinks in the staged copy ($1). Exactly one shape is followed:
# skills/<name> -> ~/.agents/skills/<name>, the layout skill installers use,
# which is copied in as a real directory. Each link is resolved from its
# ORIGINAL place under CONFIG_SRC, not from the stage. Every other link --
# dangling, pointing anywhere else, a top-level item, or nested inside a copied
# package -- is dropped with a warning: following it could pull any host file in.
materialize_config_links() {
  local stage="$1" agents link rel target
  agents="$(cd -P "$HOME/.agents/skills" 2>/dev/null && pwd -P)" || agents=""

  if [ -n "$agents" ] && [ -d "$stage/skills" ]; then
    while IFS= read -r -d '' link; do
      rel="${link#"$stage"/}"
      target="$(link_dir_target "${CONFIG_SRC}/${rel}")" || continue
      [ "$target" = "${agents}/${rel#skills/}" ] || continue
      rm -f "$link" && cp -R "$target" "$link" \
        || echo "config: could not copy ~/.claude/${rel} from ${target}; skipping it." >&2
    done < <(find "$stage/skills" -mindepth 1 -maxdepth 1 -type l -print0)
  fi

  while IFS= read -r -d '' link; do
    rel="${link#"$stage"/}"
    echo "config: skipped ~/.claude/${rel} (symlink to $(readlink "$link"); only skills/<name> -> ~/.agents/skills/<name> is followed)" >&2
    rm -f "$link"
  done < <(find "$stage" -type l -print0)
}

# Remove denylisted names from the stage ($1), saying so.
drop_denied_config() {
  local stage="$1" p
  while IFS= read -r -d '' p; do
    config_denied "${p##*/}" || continue
    [ -e "$p" ] || continue          # already gone with a denied parent
    echo "config: skipped ~/.claude/${p#"$stage"/} (looks like a credential)" >&2
    rm -rf "$p"
  done < <(find "$stage" -mindepth 1 -print0)
}

# Stage the allowlist, sanitize it, and pack it into CONFIG_BUNDLE (left empty
# when there is nothing to send, or it's over the size cap).
build_config_bundle() {
  CONFIG_BUNDLE=""
  GUEST_BUNDLE=""
  [ "$CONFIG_SYNC" != "0" ] || return 0
  [ -d "$CONFIG_SRC" ] || return 0
  command -v tar >/dev/null 2>&1 || {
    echo "warning: tar not found on the host, skipping ~/.claude config." >&2
    return 0
  }

  CONFIG_TMP="$(mktemp -d "${TMPDIR:-/tmp}/vm-claude-config.XXXXXX")" || return 0
  chmod 700 "$CONFIG_TMP"
  ensure_traps
  local stage="${CONFIG_TMP}/stage" item items="" n bytes kb
  mkdir -p "$stage/claude"

  # CONFIG_ITEMS is intentionally split on whitespace; entries can't contain it.
  for item in $CONFIG_ITEMS; do
    case "$item" in
      .|..|*/*|*[!A-Za-z0-9._-]*) echo "config: ignoring item '${item}' (must be a plain file or dir name)" >&2; continue ;;
    esac
    [ -e "${CONFIG_SRC}/${item}" ] || [ -L "${CONFIG_SRC}/${item}" ] || continue
    items="${items} ${item}"
    if [ "$item" = settings.json ] && [ ! -L "${CONFIG_SRC}/${item}" ]; then
      sanitize_settings "${CONFIG_SRC}/${item}" "${stage}/claude/${item}" \
        || echo "warning: could not sanitize ${CONFIG_SRC}/settings.json (not a JSON object, or no jq/node/python3 on the host); not copying it." >&2
      continue
    fi
    cp -RP "${CONFIG_SRC}/${item}" "${stage}/claude/${item}" \
      || echo "warning: could not fully copy ${CONFIG_SRC}/${item}; the guest gets what was readable." >&2
  done

  materialize_config_links "$stage/claude"
  drop_denied_config "$stage/claude"

  n="$(find "$stage/claude" -type f | wc -l | tr -d ' ')"
  bytes="$(find "$stage/claude" -type f -exec cat {} + 2>/dev/null | wc -c | tr -d ' ')"
  kb=$(( (bytes + 1023) / 1024 ))
  if [ "$kb" -gt "$CONFIG_MAX_KB" ]; then
    echo "warning: ~/.claude subset is ${kb}KB (limit ${CONFIG_MAX_KB}KB), not copying into the guest." >&2
    echo "  see what's in it with --show-config; trim CLAUDE_VM_CONFIG_ITEMS or raise CLAUDE_VM_CONFIG_MAX_KB." >&2
    return 0
  fi

  {
    printf 'files %s\nbytes %s\n' "$n" "$bytes"
    for item in $items; do printf 'item %s\n' "$item"; done
  } > "$stage/MANIFEST"

  # macOS `tar` is bsdtar and stamps Apple xattrs (com.apple.provenance, ...)
  # into the archive; GNU tar in the guest can't read them and warns once per
  # file. Strip that metadata at the source so the bundle is plain portable tar.
  local tar_flags=()
  case "$(uname -s)" in
    Darwin) tar_flags=(--no-mac-metadata --no-xattrs) ;;
  esac
  tar ${tar_flags[@]+"${tar_flags[@]}"} -czf "${CONFIG_TMP}/config.tgz" -C "$stage" MANIFEST claude 2>/dev/null || {
    echo "warning: could not pack the ~/.claude config; not copying it." >&2
    return 0
  }
  CONFIG_BUNDLE="${CONFIG_TMP}/config.tgz"
  # Unique per run, so two sessions on one VM (e.g. two worktrees) can't collide.
  GUEST_BUNDLE="${GUEST_STATE_DIR}/inbox/config-$$-${RANDOM}.tgz"
  echo "config: copying ${n} file(s), ${kb}KB, from ${CONFIG_SRC} into the guest (--show-config lists them)." >&2
}

# --show-config: what a run would copy, without starting anything.
show_config() {
  build_config_bundle
  if [ -z "$CONFIG_BUNDLE" ]; then
    echo "Nothing would be copied into the guest." >&2
    return 0
  fi
  (cd "${CONFIG_TMP}/stage/claude" && find . -type f | sed 's|^\./|~/.claude/|' | LC_ALL=C sort)
}

# Resume path: stream the bundle into the VM (msb exec starts a stopped one).
# If that fails, the session still starts, on the config the VM already has.
push_config_bundle() {
  [ -n "$GUEST_BUNDLE" ] || return 0
  # shellcheck disable=SC2016  # expanded by the guest shell
  if ! msb exec --stream "$NAME" -- sh -c 'mkdir -p "${1%/*}" && cat > "$1.part" && mv -f "$1.part" "$1"' _ "$GUEST_BUNDLE" < "$CONFIG_BUNDLE"; then
    echo "warning: could not copy the ~/.claude config into ${NAME}; starting with the config it already has." >&2
    GUEST_BUNDLE=""
  fi
}

# Guest side (POSIX sh, runs before claude or the shell starts): unpack the
# bundle at $cfg into a scratch dir, check it against its manifest, and only
# then replace the managed entries of ~/.claude. Managed = what this bundle
# lists plus what the previous one did, so entries dropped on the host (or no
# longer shipped, like hooks/) disappear from the guest too. A bundle that fails
# the check leaves the previous config untouched. Read via `read -r -d ''` for
# the same bash-3.2 reason as the clipboard shim above.
IFS= read -r -d '' GUEST_CONFIG_ACTIVATE_SRC <<'EOA' || true
if [ -n "$cfg" ] && [ -f "$cfg" ]; then
  st="${VM_CLAUDE_STATE:-/var/lib/vm-claude}"
  new="$st/config.new.$$"
  ok=0
  rm -rf "$new" && mkdir -p "$new" "$HOME/.claude" \
    && tar -xzf "$cfg" -C "$new" --no-same-owner 2>/dev/null \
    && [ -f "$new/MANIFEST" ] && [ -d "$new/claude" ] \
    && [ "$(sed -n 's/^files //p' "$new/MANIFEST")" = "$(find "$new/claude" -type f | wc -l | tr -d ' ')" ] \
    && [ "$(sed -n 's/^bytes //p' "$new/MANIFEST")" = "$(find "$new/claude" -type f -exec cat {} + 2>/dev/null | wc -c | tr -d ' ')" ] \
    && ok=1
  if [ "$ok" = 1 ]; then
    prev="$(cat "$st/managed" 2>/dev/null || echo 'CLAUDE.md settings.json keybindings.json agents commands skills hooks output-styles')"
    cur="$(sed -n 's/^item //p' "$new/MANIFEST")"
    for item in $(printf '%s\n' $prev $cur | sort -u); do
      case "$item" in .|..|*/*|*[!A-Za-z0-9._-]*) continue ;; esac
      rm -rf "$HOME/.claude/$item"
      if [ -e "$new/claude/$item" ]; then mv "$new/claude/$item" "$HOME/.claude/$item"; fi
    done
    printf '%s\n' $cur > "$st/managed"
    find "$HOME/.claude" -name '._*' -type f -delete 2>/dev/null
  else
    echo "vm-claude: the ~/.claude config bundle failed its integrity check; keeping the previous config." >&2
  fi
  rm -rf "$new" "$cfg"
fi
# Bundles left behind by sessions that never got this far (killed mid-start).
find "${VM_CLAUDE_STATE:-/var/lib/vm-claude}/inbox" -name 'config-*' -mmin +60 -delete 2>/dev/null
EOA

# --- host git on a guest-writable repo -------------------------------------
# /workspace IS the host repo, .git included, and the guest can write all of it.
# Git honours a repo's own .git/config and hooks, so whatever the guest plants
# there -- core.fsmonitor, core.hooksPath, hooks/*, gpg.*program, filter drivers
# -- runs on the HOST, as the host user, the next time host git touches the repo.
# So every git call vm-claude makes on the mounted repo goes through hgit, which
# switches off the two paths that fire on ordinary commands. The riskier
# operations (signing, checkout) get their own handling below.
hgit() {
  git -c core.hooksPath=/dev/null -c core.fsmonitor=false "$@"
}

# Absolute, physical path of the repo's common git dir -- where config, hooks
# and objects live, shared by every linked worktree. $1 = a path in the repo.
git_common_dir() {
  local d
  d="$(hgit -C "$1" rev-parse --git-common-dir 2>/dev/null)" || return 1
  case "$d" in /*) ;; *) d="$1/$d" ;; esac
  (cd "$d" 2>/dev/null && pwd -P)
}

# Repo-local config keys that make git run a program (or pull in more config).
GIT_EXEC_KEYS='^(core\.(fsmonitor|hookspath|sshcommand|editor|pager|askpass|gitproxy|alternaterefscommand|attributesfile|worktree)|sequence\.editor|pager\..*|gpg\..*program|gpg\.ssh\.defaultkeycommand|diff\.external|diff\..*\.(command|textconv)|merge\..*\.driver|(diff|merge)tool\..*\.(cmd|path)|filter\..*\.(clean|smudge|process)|credential\..*|alias\..*|include\.path|includeif\..*\.path|remote\..*\.(uploadpack|receivepack|vcs)|protocol\..*\.allow|submodule\..*\.update|sendemail\..*cmd|(browser|man)\..*\.(cmd|path)|web\.browser)$'

# The repo's config files, as git reads them for this repo: the common config,
# plus per-worktree config.worktree files. $1 = common git dir.
git_config_files() {
  local f
  for f in "$1/config" "$1/config.worktree" "$1"/worktrees/*/config.worktree; do
    [ -f "$f" ] && printf '%s\n' "$f"
  done
  return 0
}

# Everything in the repo that would make host git execute something: matching
# config entries and live hooks. One "name<TAB>checksum" line each, so two
# snapshots diff cleanly without printing values (a local url.*.insteadOf or
# credential entry can hold a token). $1 = common git dir.
git_exec_snapshot() {
  local common="$1" f entry key hp p
  while IFS= read -r f; do
    git config --file "$f" -z --get-regexp "$GIT_EXEC_KEYS" 2>/dev/null \
      | while IFS= read -r -d '' entry; do
          key="${entry%%$'\n'*}"
          printf '%s\t%s\n' "$key" "$(printf '%s' "$entry" | cksum | cut -d' ' -f1)"
        done
  done < <(git_config_files "$common")

  hp="$(git config --file "$common/config" --get core.hookspath 2>/dev/null || true)"
  case "$hp" in ''|/*) ;; *) hp="${HOST_GIT_WORKTREE}/${hp}" ;; esac
  for p in "$common/hooks" ${hp:+"$hp"}; do
    [ -d "$p" ] || continue
    find "$p" -maxdepth 1 \( -type f -o -type l \) ! -name '*.sample' 2>/dev/null \
      | while IFS= read -r f; do
          printf 'hook %s\t%s\n' "$f" "$(cksum < "$f" 2>/dev/null | cut -d' ' -f1)"
        done
  done
  return 0
}

# Snapshot the repo before the VM runs; report on exit anything the session
# added or changed. It can't undo it (the user may have meant it, e.g. a hook
# manager), but it stops a planted fsmonitor or hook from going unnoticed until
# the next host `git status` runs it.
GIT_AUDIT_COMMON=""
GIT_AUDIT_BEFORE=""
arm_git_audit() {
  command -v git >/dev/null 2>&1 || return 0
  GIT_AUDIT_COMMON="$(git_common_dir "$HOST_GIT_WORKTREE")" || { GIT_AUDIT_COMMON=""; return 0; }
  GIT_AUDIT_BEFORE="$(git_exec_snapshot "$GIT_AUDIT_COMMON")"
  ensure_traps
}

report_git_audit() {
  [ -n "$GIT_AUDIT_COMMON" ] || return 0
  local changed
  changed="$(comm -13 <(printf '%s\n' "$GIT_AUDIT_BEFORE" | LC_ALL=C sort) \
                      <(git_exec_snapshot "$GIT_AUDIT_COMMON" | LC_ALL=C sort) \
             | cut -f1 | LC_ALL=C sort -u)"
  [ -n "$changed" ] || return 0
  echo "warning: this session added or changed executable git config in ${GIT_AUDIT_COMMON}:" >&2
  printf '%s\n' "$changed" | sed 's/^/  /' >&2
  echo "  Host git runs these on your next git command in this repo. Review them first:" >&2
  echo "    git config --file '${GIT_AUDIT_COMMON}/config' --list; ls -la '${GIT_AUDIT_COMMON}/hooks'" >&2
}

# --- sign the VM's commits, on the host ------------------------------------
# /workspace IS the host repo (we mount the git root), so commits made in the
# guest are already real objects in the host's .git -- they just carry no
# signature, because no signing key is ever copied in. Re-create them out here,
# where the key lives.
host_head() {
  hgit -C "$HOST_GIT_WORKTREE" rev-parse HEAD 2>/dev/null || true
}

# Signing settings, read from the host's GLOBAL git config when the hook is
# armed (before the VM runs) and handed explicitly to the signing git. Never
# read from the repo: its .git/config is guest-writable, and a gpg.program or
# gpg.ssh.program there names the program host git would run to sign.
SIGN_CFG=()
capture_sign_config() {
  local k v
  SIGN_CFG=()
  for k in user.name user.email user.signingkey gpg.format gpg.program \
           gpg.openpgp.program gpg.ssh.program gpg.x509.program gpg.ssh.defaultKeyCommand; do
    v="$(git -C "$HOST_GIT_WORKTREE" config --global --includes --get "$k" 2>/dev/null)" || continue
    SIGN_CFG+=(-c "${k}=${v}")
  done
}

# Re-create every commit in $3..$4, signed, keeping each tree, author, date and
# message, and mapping parents (so merges survive). Prints the new tip.
#
# Runs in a throwaway GIT_DIR ($1) that shares only the repo's object store
# ($2): that git has no repo config and no hooks, so nothing the guest wrote
# into .git can run. Signing config comes solely from SIGN_CFG.
sign_commit_range() (
  local tmp="$1" objects="$2" before="$3" after="$4"
  local c rest p np tree ident name email date new="" map="$1/map"
  local parents
  unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_COMMON_DIR GIT_OBJECT_DIRECTORY GIT_ALTERNATE_OBJECT_DIRECTORIES
  git init -q --bare --template= "$tmp" >/dev/null 2>&1 || exit 1
  export GIT_DIR="$tmp" GIT_OBJECT_DIRECTORY="$objects"
  cd "$tmp" || exit 1
  export LC_ALL=C
  : > "$map"

  git rev-list --reverse --topo-order --parents "${before}..${after}" > "$tmp/list" || exit 1
  while read -r c rest; do
    tree="$(git rev-parse "${c}^{tree}")" || exit 1
    parents=()
    for p in $rest; do
      np="$(awk -v k="$p" '$1 == k { print $2 }' "$map")"
      parents+=(-p "${np:-$p}")
    done
    ident="$(git cat-file commit "$c" | sed -n '/^$/q; s/^author //p')" || exit 1
    name="${ident%% <*}"
    email="${ident#* <}"; email="${email%%>*}"
    date="${ident##*> }"
    new="$(git cat-file commit "$c" | sed '1,/^$/d' \
      | GIT_AUTHOR_NAME="$name" GIT_AUTHOR_EMAIL="$email" GIT_AUTHOR_DATE="$date" \
        git ${SIGN_CFG[@]+"${SIGN_CFG[@]}"} commit-tree -S "$tree" ${parents[@]+"${parents[@]}"})" || exit 1
    printf '%s %s\n' "$c" "$new" >> "$map"
  done < "$tmp/list"
  [ -n "$new" ] || exit 1
  printf '%s\n' "$new"
)

sign_new_commits() {
  local before="$1" after branch n common tmp new
  after="$(host_head)"

  if [ -z "$before" ] || [ -z "$after" ]; then
    echo "sign-on-exit: could not read HEAD in ${HOST_GIT_WORKTREE}, skipping." >&2
    return 0
  fi
  if [ "$before" = "$after" ]; then
    echo "sign-on-exit: no new commits." >&2
    return 0
  fi

  branch="$(hgit -C "$HOST_GIT_WORKTREE" symbolic-ref --quiet --short HEAD 2>/dev/null || true)"
  if [ -z "$branch" ]; then
    echo "sign-on-exit: HEAD is detached, skipping." >&2
    echo "  sign manually: git -C '${HOST_GIT_WORKTREE}' rebase -f -S ${before}" >&2
    return 0
  fi

  # If claude rebased or reset rather than just committing, $before is no
  # longer an ancestor and rewriting from it would discard work. Bail instead.
  if ! hgit -C "$HOST_GIT_WORKTREE" merge-base --is-ancestor "$before" "$after" 2>/dev/null; then
    echo "sign-on-exit: history diverged from ${before}, skipping to avoid rewriting it." >&2
    return 0
  fi

  if ! common="$(git_common_dir "$HOST_GIT_WORKTREE")"; then
    echo "sign-on-exit: could not locate the git dir of ${HOST_GIT_WORKTREE}, skipping." >&2
    return 0
  fi

  n="$(hgit -C "$HOST_GIT_WORKTREE" rev-list --count "${before}..${after}" 2>/dev/null || echo 0)"
  echo "sign-on-exit: signing ${n} new commit(s) on ${branch}..." >&2

  tmp="$(mktemp -d "${TMPDIR:-/tmp}/vm-claude-sign.XXXXXX")"
  # update-ref with the old value is a compare-and-swap: if the branch moved
  # while we were signing, nothing is overwritten. Same trees, so the index and
  # working tree (uncommitted work included) are left exactly as they were.
  if new="$(sign_commit_range "$tmp" "${common}/objects" "$before" "$after")" \
     && hgit -C "$HOST_GIT_WORKTREE" update-ref -m "vm-claude: sign-on-exit" \
          "refs/heads/${branch}" "$new" "$after"; then
    echo "sign-on-exit: done, ${branch} is now $(hgit -C "$HOST_GIT_WORKTREE" rev-parse --short HEAD)." >&2
  else
    echo "sign-on-exit: signing failed, nothing rewritten." >&2
    echo "  retry manually: git -C '${HOST_GIT_WORKTREE}' rebase -f -S ${before}" >&2
    echo "  (review .git/config and .git/hooks first -- the VM could write them)" >&2
  fi
  rm -rf "$tmp"
}

# A single exit path shared by --sign-on-exit, the git audit and the clipboard
# watcher: the EXIT trap does the work; the signal traps just turn a signal into
# an exit so it runs exactly once whichever way we go down (clean /q, Ctrl-C,
# closed terminal).
TRAPS_SET=0
on_exit() {
  if [ "$SIGN_ON_EXIT" = "1" ] && [ -n "$HEAD_BEFORE" ]; then
    sign_new_commits "$HEAD_BEFORE"
  fi
  report_git_audit || true
  [ -n "$WATCHER_PID" ] && kill "$WATCHER_PID" 2>/dev/null || true
  [ -n "$CONFIG_TMP" ] && rm -rf "$CONFIG_TMP" 2>/dev/null || true
}
ensure_traps() {
  [ "$TRAPS_SET" = "1" ] && return 0
  TRAPS_SET=1
  trap on_exit EXIT
  trap 'exit 130' INT
  trap 'exit 143' TERM
  trap 'exit 129' HUP
}

# Arm the exit hook: note HEAD now, sign whatever the VM adds on the way out.
# Announced out loud, because a silent arm is indistinguishable from a flag
# that was never passed -- which is exactly how this looks when it misfires.
arm_sign_on_exit() {
  [ "$SIGN_ON_EXIT" = "1" ] || return 0

  HEAD_BEFORE="$(host_head)"
  if [ -z "$HEAD_BEFORE" ]; then
    echo "sign-on-exit: no HEAD in ${HOST_GIT_WORKTREE} to compare against, not arming." >&2
    return 0
  fi
  capture_sign_config
  case " ${SIGN_CFG[*]-} " in
    *" user.signingkey="*) ;;
    *) echo "warning: --sign-on-exit given but user.signingkey is unset in the host's global git config." >&2 ;;
  esac

  echo "sign-on-exit: armed at $(hgit -C "$HOST_GIT_WORKTREE" rev-parse --short HEAD)." >&2
  # Sign on a clean /q, and also when the session is interrupted or its terminal
  # is closed -- Ctrl-C, SIGTERM, SIGHUP. The signal traps only exit; the EXIT
  # trap does the signing, so it runs exactly once whichever way we go down.
  ensure_traps
}

# --- clipboard bridge wiring -----------------------------------------------
# Shell fragment (ends in `&&`) that installs the guest shim and turns on
# Claude's Linux clipboard path -- it only probes the clipboard when DISPLAY or
# WAYLAND_DISPLAY is set, so we set DISPLAY. Empty unless --clip is on.
clip_guest_setup_cmd() {
  [ "$CLIP_ENABLE" = "1" ] || return 0
  local b64
  b64="$(printf '%s' "$CLIP_SHIM_SRC" | base64 | tr -d '\n')"
  printf '%s\n' \
    "printf %s '${b64}' | base64 -d > /usr/local/bin/xclip && chmod 0755 /usr/local/bin/xclip &&" \
    "export DISPLAY=:0 && export VM_CLIP_DIR=/run/vm-clip &&"
}

# Non-fatal guest check (ends in `;`) that warns if the bridge isn't actually
# wired up -- e.g. --clip on a VM first booted without it, so the mount is
# absent. The shim already fails fast in that case; this just explains why.
clip_ready_check_cmd() {
  [ "$CLIP_ENABLE" = "1" ] || return 0
  printf '%s\n' \
    '{ [ -e /run/vm-clip/ready ] || { sleep 0.5; [ -e /run/vm-clip/ready ]; } || echo "vm-claude: clipboard bridge not active for this VM; recreate with --rm to enable." >&2; } ;'
}

# Launch the host-side watcher and arm its teardown. macOS only (guarded by the
# caller). Creates the shared dir the boot-time mount points at, so it must run
# before start_fresh.
start_watcher() {
  [ "$CLIP_ENABLE" = "1" ] || return 0
  ensure_pngpaste
  mkdir -p "$CLIP_SHARED" "$CLIP_WORK"
  local w="${CLIP_ROOT}/watcher.sh"
  printf '%s\n' "$CLIP_WATCHER_SRC" > "$w"
  sh "$w" "$CLIP_SHARED" "$CLIP_WORK" "$NAME" &
  WATCHER_PID=$!
  printf '%s\n' "$WATCHER_PID" > "${CLIP_ROOT}/watcher.pid" 2>/dev/null || true
  ensure_traps
  echo "clipboard: bridge armed -- you'll approve each paste in a host dialog." >&2
}

# True if $1 is a live process whose command line is this VM's watcher. Reads
# /proc where it exists (Linux) and falls back to ps (macOS) -- so the identity
# check works on both without assuming either is present.
pid_is_our_watcher() {
  local pid="$1" cmd=""
  [ -n "$pid" ] || return 1
  if [ -r "/proc/$pid/cmdline" ]; then
    cmd="$(tr '\0' ' ' < "/proc/$pid/cmdline" 2>/dev/null || true)"
  else
    cmd="$(ps -p "$pid" -o command= 2>/dev/null || true)"
  fi
  printf '%s' "$cmd" | grep -qF "${CLIP_ROOT}/watcher.sh"
}

# Kill any clipboard watcher still running for THIS VM (e.g. one a hard kill
# orphaned, whose EXIT trap never fired). Uses the pid recorded at launch, and
# only kills it after confirming that pid is still *our* watcher -- so a stale
# pidfile whose pid was recycled by an unrelated process is left untouched.
stop_stray_watcher() {
  local pidfile="${CLIP_ROOT}/watcher.pid" pid
  [ -f "$pidfile" ] || return 0
  pid="$(cat "$pidfile" 2>/dev/null || true)"
  pid_is_our_watcher "$pid" && kill "$pid" 2>/dev/null || true
  rm -f "$pidfile" 2>/dev/null || true
}

# Wipe this VM's host-side clipboard state: stray watcher + the whole cache dir.
clip_wipe() {
  stop_stray_watcher
  rm -rf "$CLIP_ROOT" 2>/dev/null || true
}

# --- --worktree: create/attach the worktree on the host -------------------
# Runs on the host before the VM starts. The worktree lives under the repo root
# so it's already inside the /workspace mount -> the same VM sees it live, no
# remount needed even on an already-running VM. Created with --relative-paths so
# the .git pointer files resolve identically on the host and under /workspace in
# the guest (whose git is too old to WRITE relative links but reads them fine).
# On first creation only, gitignored + untracked files (.env, secrets, ...) are
# copied in from the main working tree, since `git worktree add` checks out only
# tracked files.
ensure_worktree() {
  [ -n "$WORKTREE_NAME" ] || return 0

  # Everything under the repo root is guest-writable, so a previous session could
  # have swapped the holder dir or the worktree itself for a symlink to anywhere
  # on the host -- and the checkout and file copy below would then write there.
  local p
  for p in "${MOUNT_DIR}/${WORKTREE_SUBDIR}" "$WT_HOST"; do
    if [ -L "$p" ]; then
      echo "worktree: refusing to use ${p}: it is a symlink (the VM can create those)." >&2
      return 1
    fi
  done

  # Already there -> attach, nothing to do (the copy is create-only).
  [ -e "$WT_HOST/.git" ] && return 0

  # Checkout runs filter drivers (smudge/process commands) named in the repo's
  # own config, and -c can't switch those off without knowing their names. That
  # config is guest-writable, so refuse rather than run one on the host. Includes
  # are refused too: they could pull in a filter from a guest-written file.
  local common risky f
  common="$(git_common_dir "$MOUNT_DIR")" || common="${MOUNT_DIR}/.git"
  risky="$(git_config_files "$common" | while IFS= read -r f; do
    git config --file "$f" --name-only --get-regexp \
      '^(filter\..*\.(smudge|clean|process)|include\.path|includeif\..*\.path)$' 2>/dev/null || true
  done)"
  if [ -n "$risky" ]; then
    echo "worktree: refusing to create '${WORKTREE_NAME}': this repo's own git config defines" >&2
    echo "  commands that a checkout would run on the host:" >&2
    printf '%s\n' "$risky" | sed 's/^/    /' >&2
    echo "  Review ${common}/config (the VM can write it), remove what you don't recognise, and re-run." >&2
    return 1
  fi

  echo "worktree: creating '${WORKTREE_NAME}' at ${WT_HOST}..." >&2
  mkdir -p "${MOUNT_DIR}/${WORKTREE_SUBDIR}"

  # Keep the worktree holder out of the main repo's status. info/exclude is local
  # (uncommitted), unlike .gitignore -- append the line once, idempotently. Not
  # through a symlink: that would append to whatever host file it points at.
  local excl="${common}/info/exclude"
  if [ -f "$excl" ] && [ ! -L "$excl" ] && ! grep -qxF "/${WORKTREE_SUBDIR}/" "$excl"; then
    printf '/%s/\n' "$WORKTREE_SUBDIR" >> "$excl"
  fi

  # Relative pointer files (git >= 2.48) so the links survive the host->guest
  # path remap. Older git: fall back to a plain add and relativize by hand below.
  local relflag="" rel_fallback=0
  if hgit worktree add -h 2>&1 | grep -q 'relative-paths'; then
    relflag="--relative-paths"
  else
    rel_fallback=1
    echo "worktree: host git lacks --relative-paths; relativizing links by hand." >&2
  fi

  if hgit -C "$MOUNT_DIR" show-ref --verify --quiet "refs/heads/${WORKTREE_NAME}"; then
    hgit -C "$MOUNT_DIR" worktree add $relflag "$WT_HOST" "$WORKTREE_NAME"
  else
    hgit -C "$MOUNT_DIR" worktree add $relflag -b "$WORKTREE_NAME" "$WT_HOST"
  fi

  # Fallback relativization: rewrite the forward gitfile and the back-pointer to
  # paths relative to the repo root, so they hold under /workspace too. Depth is
  # fixed by WORKTREE_SUBDIR/WORKTREE_NAME (two levels below the root).
  if [ "$rel_fallback" = 1 ]; then
    local gitdir="${MOUNT_DIR}/.git/worktrees/${WORKTREE_NAME}"
    printf 'gitdir: ../../.git/worktrees/%s\n' "$WORKTREE_NAME" > "$WT_HOST/.git"
    [ -f "$gitdir/gitdir" ] && \
      printf '../../../%s/%s/.git\n' "$WORKTREE_SUBDIR" "$WORKTREE_NAME" > "$gitdir/gitdir"
  fi

  # Copy untracked + gitignored files from the main working tree into the fresh
  # worktree (create-only). Reuse tar (already a hard dep) with a NUL-safe file
  # list; `.git` is never listed by `ls-files --others`, and tracked files the
  # worktree already checked out are left untouched. The ignored pass lists the
  # worktree holder ($WORKTREE_SUBDIR) as a collapsed nested-repo entry that
  # pathspec exclusion won't drop, so it gets copied in -- then removed right
  # after, so the worktree never ends up nested inside itself.
  if command -v tar >/dev/null 2>&1; then
    { hgit -C "$MOUNT_DIR" ls-files -z --others --exclude-standard
      hgit -C "$MOUNT_DIR" ls-files -z --others --ignored --exclude-standard; } \
      | tar -C "$MOUNT_DIR" --null -T - -cf - 2>/dev/null \
      | tar -C "$WT_HOST" -xf - 2>/dev/null \
      && echo "worktree: copied gitignored/untracked files into ${WORKTREE_NAME}." >&2 \
      || echo "worktree: nothing extra to copy (or copy skipped)." >&2
    rm -rf "${WT_HOST:?}/${WORKTREE_SUBDIR}" 2>/dev/null || true
  fi
}

# Shell fragment (ending in `&&`) marking the worktree path as a safe git dir in
# the guest. `safe.directory /workspace` doesn't cover a linked worktree's own
# top-level, so without this git in the guest refuses it as dubiously-owned.
worktree_safe_dir_cmd() {
  [ -n "$WORKTREE_NAME" ] || return 0
  printf "git config --global --add safe.directory '%s' &&\n" "$GUEST_WORKDIR"
}

# The one guest setup script, shared by a fresh boot, a resume and --shell, so
# every entry path gets the same config, tools and environment. Positional args:
# $1 guest workdir, $2 timezone, $3 config bundle path in the guest (or ""), and
# the rest is the command to exec at the end (claude + its args, or a shell).
# Values ride in as args rather than being spliced into the script text.
guest_prepare_script() {
  cat <<EOF
cd "\$1" || exit 1
[ -n "\$2" ] && export TZ="\$2"
cfg="\$3"
shift 3
if ! command -v git >/dev/null 2>&1; then
  echo "vm-claude: first boot, installing base packages..." >&2
  { apt-get update &&
    apt-get install -y --no-install-recommends ca-certificates git tzdata &&
    $(tz_setup_cmd)
    git config --global --add safe.directory /workspace &&
    $(host_git_config)
    true; } || exit 1
fi
$(worktree_safe_dir_cmd) true
if command -v claude >/dev/null 2>&1; then
  echo "Updating claude (@${VERSION})..." >&2
  npm install -g @anthropic-ai/claude-code@${VERSION} --no-fund --no-audit --loglevel=error || echo "vm-claude: claude update failed; using the version already installed." >&2
else
  npm install -g @anthropic-ai/claude-code@${VERSION} --no-fund --no-audit --loglevel=error || exit 1
fi
${GUEST_CONFIG_ACTIVATE_SRC}
$(clip_guest_setup_cmd) true
$(clip_ready_check_cmd)
export IS_SANDBOX=1
exec "\$@"
EOF
}

# Boot a new VM and run "$@" in it after guest_prepare_script.
start_fresh() {
  local ceiling=""
  if [ "$CEILING_SET" = "1" ]; then
    ceiling=", up to ${MAX_CPUS} cpu / ${MAX_MEMORY}"
  fi
  echo "Booting new microVM '${NAME}' (image ${IMAGE}, ${CPUS} cpu / ${MEMORY} ram / ${DISK} disk${ceiling})..." >&2
  local clip_mount=() copy=()
  if [ "$CLIP_ENABLE" = "1" ]; then
    clip_mount=(--mount-dir "${CLIP_SHARED}:/run/vm-clip:rw")
  fi
  if [ -n "$GUEST_BUNDLE" ]; then
    copy=(--copy-file "${CONFIG_BUNDLE}:${GUEST_BUNDLE}")
  fi
  msb run -t --name "$NAME" --replace \
    --cpus "$CPUS" --memory "$MEMORY" --root-disk "$DISK" \
    ${MAX_FLAGS[@]+"${MAX_FLAGS[@]}"} \
    --mount-dir "${MOUNT_DIR}:/workspace:rw" \
    ${clip_mount[@]+"${clip_mount[@]}"} \
    ${copy[@]+"${copy[@]}"} \
    --workdir "$GUEST_WORKDIR" \
    "$IMAGE" -- sh -lc "$(guest_prepare_script)" _ "$GUEST_WORKDIR" "$TZ_NAME" "$GUEST_BUNDLE" "$@"
}

# Run "$@" in the existing VM after guest_prepare_script. The config is re-sent
# on every resume, so edits to the host's ~/.claude show up next run.
resume() {
  echo "Resuming microVM '${NAME}'..." >&2
  push_config_bundle
  msb exec -t "$NAME" -- sh -lc "$(guest_prepare_script)" _ "$GUEST_WORKDIR" "$TZ_NAME" "$GUEST_BUNDLE" "$@"
}

main() {
  local mode="run"
  local passthru=()

  while [ $# -gt 0 ]; do
    case "$1" in
      --shell) mode="shell"; shift ;;
      --show-config) mode="show-config"; shift ;;
      --stop)  mode="stop";  shift ;;
      --rm)    mode="rm";    shift ;;
      --sign-on-exit)    SIGN_ON_EXIT=1; shift ;;
      --no-sign-on-exit) SIGN_ON_EXIT=0; shift ;;
      --clip)    CLIP_ENABLE=1; CLIP_EXPLICIT=1; shift ;;
      --no-clip) CLIP_ENABLE=0; CLIP_EXPLICIT=1; shift ;;
      --worktree) WORKTREE_NAME="${2:?--worktree needs a name}"; shift 2 ;;
      --worktree=*) WORKTREE_NAME="${1#*=}"; shift ;;
      --cpus)   CPUS="${2:?--cpus needs a value}"; shift 2 ;;
      --cpus=*) CPUS="${1#*=}"; shift ;;
      --memory)   MEMORY="${2:?--memory needs a value}"; shift 2 ;;
      --memory=*) MEMORY="${1#*=}"; shift ;;
      --disk)   DISK="${2:?--disk needs a value}"; DISK_EXPLICIT=1; shift 2 ;;
      --disk=*) DISK="${1#*=}"; DISK_EXPLICIT=1; shift ;;
      --max-cpus)   MAX_CPUS="${2:?--max-cpus needs a value}"; shift 2 ;;
      --max-cpus=*) MAX_CPUS="${1#*=}"; shift ;;
      --max-memory)   MAX_MEMORY="${2:?--max-memory needs a value}"; shift 2 ;;
      --max-memory=*) MAX_MEMORY="${1#*=}"; shift ;;
      --resize) RESIZE=1; shift ;;
      --)      shift; passthru+=("$@"); break ;;
      *)       passthru+=("$1"); shift ;;
    esac
  done

  # Needs neither msb nor a VM: just shows what a run would copy.
  if [ "$mode" = show-config ]; then
    show_config
    return 0
  fi

  resolve_limits
  ensure_msb

  # The clipboard watcher reads the macOS pasteboard (pngpaste/pbpaste/osascript);
  # there's no portable equivalent to bridge here, so it's macOS-host only. It's
  # on by default, so stay quiet when disabling on a non-macOS host unless the
  # user asked for it explicitly.
  if [ "$CLIP_ENABLE" = "1" ] && [ "$(uname -s)" != "Darwin" ]; then
    [ "$CLIP_EXPLICIT" = "1" ] && echo "clipboard: --clip needs a macOS host; disabling for this run." >&2
    CLIP_ENABLE=0
  fi

  case "$mode" in
    stop)
      stop_stray_watcher
      msb stop "$NAME" && echo "Stopped ${NAME}." ;;
    rm)
      msb stop "$NAME" 2>/dev/null || true
      msb remove "$NAME" 2>/dev/null || msb rm "$NAME"
      clip_wipe
      echo "Removed ${NAME} (state wiped)." ;;
    shell|run)
      # The microVM is already the sandbox: only the project dir is visible and
      # everything else in the guest is throwaway. So run claude unattended by
      # default; IS_SANDBOX=1 in the guest is what lets the flag work as root.
      local cmd=(sh -l)
      if [ "$mode" = run ]; then
        if [ "$SKIP_PERMISSIONS" != "0" ]; then
          passthru=(--dangerously-skip-permissions ${passthru[@]+"${passthru[@]}"})
        fi
        cmd=(claude ${passthru[@]+"${passthru[@]}"})
      fi
      ensure_worktree
      arm_sign_on_exit
      arm_git_audit
      build_config_bundle
      start_watcher
      if vm_exists; then
        if [ "$RESIZE" = "1" ]; then apply_resize; fi
        resume "${cmd[@]}"
      else
        if [ "$RESIZE" = "1" ]; then
          echo "vm-claude: no VM for this project yet -- booting one at the requested size." >&2
        fi
        start_fresh "${cmd[@]}"
      fi ;;
  esac
}

# test/run.sh sources this file to exercise the host-side functions directly.
[ "${VM_CLAUDE_SOURCED:-0}" = 1 ] || main "$@"
